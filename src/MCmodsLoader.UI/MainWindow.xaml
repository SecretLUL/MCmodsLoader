<Window x:Class="MCmodsLoader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCmodsLoader.UI"
        mc:Ignorable="d"
        Title="MCmodsLoader - Zero-Setup Performance Injector for the Vanilla Launcher"
        Height="720" Width="920"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable, sans-serif">

    <Window.Resources>
        <!-- Modern ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Status Badge Template / Triggers -->
        <Style x:Key="BadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Progress Bar -->
        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#10B981"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Update Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Config Cards -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Mods Section Header -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Mods List -->
            <RowDefinition Height="*"/>
            <!-- 5: Action & Progress Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ MCmodsLoader" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                        <TextBlock x:Name="TxtAppVersion" Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Zero-Setup Performance Injector for the Vanilla Launcher"
                           FontSize="13" FontWeight="SemiBold" Foreground="#10B981" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnOpenModsFolder" Content="📁 Open Mods Folder"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Click="BtnOpenModsFolder_Click"/>
                <Button x:Name="BtnRefresh" Content="🔄 Refresh"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                        Click="BtnRefresh_Click"/>
                <Button x:Name="BtnCheckUpdates" Content="🚀 Check Updates"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="BtnCheckUpdates_Click"/>
            </StackPanel>
        </Grid>

        <!-- 1: Update Banner (hidden by default) -->
        <Border x:Name="BannerUpdate" Grid.Row="1" Background="#064E3B" BorderBrush="#059669" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtUpdateTitle" Text="🎉 A new update is available!" FontWeight="Bold" Foreground="#ECFDF5" FontSize="13"/>
                    <TextBlock x:Name="TxtUpdateDetails" Text="Click Update Now to download and restart automatically." Foreground="#A7F3D0" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnApplyUpdate" Grid.Column="1" Content="Update Now"
                        Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="12"
                        Click="BtnApplyUpdate_Click"/>
            </Grid>
        </Border>

        <!-- 2: Config Cards -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Minecraft Directory Card -->
            <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="MINECRAFT DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtMinecraftPath" Grid.Column="0" Text="Detecting .minecraft..."
                                   Foreground="#F8FAFC" FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="BtnBrowsePath" Grid.Column="1" Content="Browse"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="8,4" FontSize="11"
                                Click="BtnBrowsePath_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Minecraft Version Card -->
            <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TARGET VERSION" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbVersions" Grid.Row="1" Height="26"
                              Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#475569"
                              SelectionChanged="CmbVersions_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- Fabric Loader Status Card -->
            <Border Grid.Column="4" Background="#1E293B" CornerRadius="8" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="FABRIC LOADER" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtFabricStatus" Grid.Column="0" Text="Checking..."
                                   Foreground="#10B981" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="BtnInstallFabric" Grid.Column="1" Content="Install Fabric"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Padding="8,4" FontSize="11"
                                Click="BtnInstallFabric_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3: Mods Section Header -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Performance &amp; QoL Mods" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text=" (Curated FPS Preset)" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Grid.Column="1" x:Name="BadgeModCount" Background="#1E293B" CornerRadius="12" Padding="10,4" BorderBrush="#334155" BorderThickness="1">
                <TextBlock x:Name="TxtModCount" Text="0 / 14 Installed" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
            </Border>
        </Grid>

        <!-- 4: Mods List (Scrollable) -->
        <Border Grid.Row="4" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ListMods">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6,3" Background="#131B2E" CornerRadius="6" Padding="12,10" BorderBrush="#1E293B" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Mod Name & Fabric ID -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC"/>
                                        <TextBlock Text="{Binding FabricModId}" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>

                                    <!-- Category Badge -->
                                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="#1E293B" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    </Border>

                                    <!-- Description -->
                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="11" Foreground="#CBD5E1"
                                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0"/>

                                    <!-- Status Pill -->
                                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                            <Setter Property="Background" Value="#064E3B"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Missing">
                                                            <Setter Property="Background" Value="#451A03"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Update available">
                                                            <Setter Property="Background" Value="#1E3A8A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                                <Setter Property="Foreground" Value="#34D399"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Missing">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Update available">
                                                                <Setter Property="Foreground" Value="#60A5FA"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding InstalledFileName}" FontSize="9" Foreground="#64748B"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="140"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 5: Action & Progress Area -->
        <Border Grid.Row="5" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,16,0,0" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top row: Status info & Big Action Button -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock x:Name="TxtStatus" Text="Ready to inject mods." FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock x:Name="TxtSubStatus" Text="Click the button on the right to install Fabric (if missing) and all performance mods."
                                   FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button x:Name="BtnInject" Grid.Column="1"
                            Content="⚡ Inject Performance Mods"
                            Style="{StaticResource PrimaryButtonStyle}"
                            FontSize="15" Padding="24,12"
                            Click="BtnInject_Click"/>
                </Grid>

                <!-- Bottom row: Progress bar -->
                <ProgressBar x:Name="PrgProgress" Grid.Row="1" Margin="0,10,0,0"
                             Style="{StaticResource ModernProgressBar}" Value="0" Maximum="100"
                             Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
