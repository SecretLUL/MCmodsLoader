<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      default_mods.json stays in the repository unchanged and is no longer built in: v1.2.x
      clients still download it from main as their mod list, and every entry in it is a
      mandatory mod to them. The current list, with optional mods, is default_mods.v2.json.
    -->
    <EmbeddedResource Include="Resources\default_mods.v2.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MCmodsLoader.Tests" />
  </ItemGroup>

</Project>
